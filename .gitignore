.DS_Store
.firebase/

# Local Firebase web config (copy from firebase-config.example.js).
# The web apiKey is a public client identifier, but keep it out of the
# repo to avoid secret-scanner noise. It still ships in the deployed JS.
public/js/firebase-config.js

# Local TMDb API key (copy from tmdb-config.example.js).
# Read-only and rate-limited, but keep it out of the repo all the same.
public/js/tmdb-config.js

# Downloaded service account keys (e.g. the github-deploy key before it is
# uploaded as a GitHub secret). Never commit one.
buku-rekod-*.json

# Stitch design exports (reference only, ~4 MB of screenshots).
stitch/
